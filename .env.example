# Copy to .env and change every password before first start.
# .env is gitignored. Do not commit it.

DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_RO_PASSWORD=change-me-ro
DB_PGBOUNCER_PASSWORD=change-me-pgb

# none = no LLM extraction at all. Correct default for Phases 1-4 (ADR-0015:
# deterministic capture only until the Review Inbox exists).
MEMORY_LLM_PROVIDER=none
MEMORY_LLM_MODEL=
MEMORY_LOG_LEVEL=info

# Generic Alertmanager webhook. Leave blank for local UI-only alerting. In a
# deployed environment point this at the approved notification relay; it must
# accept Alertmanager's generic webhook JSON payload and route it to Slack,
# Teams, PagerDuty, email, or the incident system.
ALERT_WEBHOOK_URL=

# Minimum raw cross-encoder score recorded as corroboration after direct
# lexical/entity support. A score alone never proves project evidence.
MEMORY_EVIDENCE_RERANK_MIN_SCORE=0.05

# GitHub-native evidence ingestion. Leave disabled until a GitHub App is
# installed for the organization and this secret matches its webhook setting.
# The private key belongs only in the real .env or a secret manager, never here.
MEMORY_GITHUB_ENABLED=false
MEMORY_GITHUB_WEBHOOK_SECRET=
MEMORY_GITHUB_APP_ID=
MEMORY_GITHUB_PRIVATE_KEY=
MEMORY_GITHUB_API_URL=https://api.github.com
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only when a Console user stores a fine-grained GitHub PAT. Keep it in
# your secret manager and use the same value for API and worker replicas.
MEMORY_GITHUB_PAT_ENCRYPTION_KEY=
MEMORY_GITHUB_EVIDENCE_SUFFIX=-evidence
MEMORY_GITHUB_WEBHOOK_MAX_BYTES=1048576
# Bound a webhook-triggered sync before it can exhaust a shared worker.
MEMORY_GITHUB_MAX_BLOB_BYTES=262144
MEMORY_GITHUB_MAX_SYNC_FILES=250

# Leave blank for local stdio transport. Required for remote HTTP transport.
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=https://memory.local/mcp
MCP_OAUTH_JWKS_URL=
# Comma-separated pinned asymmetric algorithms. Never enable HS* with a JWKS.
MCP_OAUTH_ALGORITHMS=RS256,ES256
MCP_OAUTH_ORG_CLAIM=org
MCP_OAUTH_PROJECT_CLAIM=project

# Browser console OAuth client. Register http://localhost:3000/ as the redirect
# URI for local development; production must use its HTTPS console origin.
CONSOLE_OIDC_CLIENT_ID=
CONSOLE_OIDC_SCOPES=openid profile
CONSOLE_OIDC_REDIRECT_URI=
CONSOLE_OIDC_RESOURCE=
# Leave blank to use the issuer's OIDC discovery document.
CONSOLE_OIDC_AUTHORIZATION_ENDPOINT=
CONSOLE_OIDC_TOKEN_ENDPOINT=
