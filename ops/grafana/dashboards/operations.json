{
  "uid": "memory-operations",
  "title": "Knowledge Platform | Command Center",
  "description": "Start here. It answers whether the platform can serve scoped knowledge now, whether an operator needs to act, and where to investigate next. Product-quality and curation work belongs on the focused dashboards, not in this incident view.",
  "tags": ["knowledge-platform", "command-center", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    { "title": "Alerting", "url": "/alerting/list", "type": "link", "icon": "bell", "targetBlank": false },
    { "title": "Explore metrics", "url": "/explore", "type": "link", "icon": "external link", "targetBlank": false }
  ],
  "panels": [
    { "type": "row", "title": "Act now", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat", "title": "Critical alerts", "description": "A non-zero value is an active incident. Open Alerting for ownership, grouping, and silences.",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Warning alerts", "description": "Warnings need engineering attention but are not a page. Informational SLO signals remain in the alert inventory.",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Core service readiness", "description": "API, Console, MCP, Postgres, and PgBouncer endpoint contracts. This is more meaningful than container or exporter process state.",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(probe_success{criticality=\"critical\"}) / count(probe_success{criticality=\"critical\"})", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "noValue": "pending", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Context requests / min", "description": "Recent retrieval traffic. A zero means there is no current serving sample; it is not a passing latency result.",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "memory:context_pack_observations_per_minute", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "noValue": "0" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Review backlog (all projects)", "description": "Portfolio-level curation pressure. Select a project in Knowledge Governance before taking a review action.",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(memory_inbox_depth)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 200 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Notification delivery failures", "description": "Outbound Alertmanager notification failures in the last 15 minutes. A zero is expected when no local webhook is configured.",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(alertmanager_notifications_failed_total[15m])) or vector(0)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },

    { "type": "row", "title": "Service contracts", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 } },
    {
      "type": "stat", "title": "Core endpoints", "description": "Each value is an externally exercised readiness contract.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{criticality=\"critical\"}", "legendFormat": "{{service}}", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "pending", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Investigation systems", "description": "Grafana, Prometheus, Alertmanager, logs, traces, and collector readiness. A failure weakens incident evidence even if requests still serve.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{criticality=\"observability\"}", "legendFormat": "{{service}}", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "pending", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Runtime loop age", "description": "Seconds since the scheduler and worker event loops last advanced. It detects a stuck loop whose HTTP metrics endpoint still responds.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "time() - memory_service_heartbeat_timestamp_seconds", "legendFormat": "{{service}}", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "noValue": "waiting for rollout", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 45 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },

    { "type": "row", "title": "Investigate", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 } },
    {
      "type": "table", "title": "Current alert inventory", "description": "The exact active labels and severity. Use Alerting to assign, group, or silence an alert.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 17 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "inspect": false } }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "type": "timeseries", "title": "Core endpoint history", "description": "A step down to zero identifies the contract that failed. Optional reranker is intentionally excluded; its effect belongs on Retrieval Reliability.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 17 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{criticality=\"critical\"}", "legendFormat": "{{service}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "API response outcomes", "description": "Request rate by response class. A 4xx spike is usually caller or scope behavior; 5xx is a serving failure.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Portfolio review backlog", "description": "All project queues. Use Knowledge Governance to isolate the project whose queue requires action.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 }, "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "memory_inbox_depth", "legendFormat": "{{project}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 200 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
