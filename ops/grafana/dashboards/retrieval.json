{
  "uid": "memory-retrieval",
  "title": "Knowledge Platform | Retrieval Reliability",
  "description": "Serving behavior under real traffic. A blank latency value means no completed request in the measurement window, not a passing or failing result.",
  "tags": ["knowledge-platform", "retrieval", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"title": "Inspect traces", "url": "/explore", "targetBlank": false},
    {"title": "Command Center", "url": "/d/memory-operations", "targetBlank": false}
  ],
  "panels": [
    {"type": "row", "title": "Serving health", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {
      "type": "stat", "title": "Context pack p95", "description": "Production objective: less than 350 ms. This value is evaluated only when traffic exists.",
      "gridPos": {"h": 5, "w": 5, "x": 0, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "memory:context_latency_p95 >= 0", "legendFormat": "p95", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "noValue": "no traffic in window", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.35}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat", "title": "Write p99", "description": "End-to-end write-to-retrievable latency. Production objective: less than 5 seconds.",
      "gridPos": {"h": 5, "w": 4, "x": 5, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "memory:write_latency_p99 >= 0", "legendFormat": "p99", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "noValue": "no traffic in window", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat", "title": "Contexts / min", "description": "Current observed retrieval volume. Low volume makes percentiles less representative.",
      "gridPos": {"h": 5, "w": 4, "x": 9, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "memory:context_pack_observations_per_minute", "legendFormat": "contexts/min", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat", "title": "Vector-degraded packs / hr", "description": "Packs served without the vector arm. Degradation protects callers but sustained failures need attention.",
      "gridPos": {"h": 5, "w": 4, "x": 13, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(memory_pack_degraded_total[1h])) or vector(0)", "legendFormat": "degraded", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat", "title": "Median memory tokens", "description": "Memory budget consumed by a typical completed retrieval.",
      "gridPos": {"h": 5, "w": 4, "x": 17, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(memory_context_pack_tokens_bucket[30m]))) >= 0", "legendFormat": "p50 tokens", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "no traffic in window", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "stat", "title": "Degraded pack ratio", "description": "Share of recent packs that omitted vector retrieval.",
      "gridPos": {"h": 5, "w": 3, "x": 21, "y": 1}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "memory:degraded_pack_ratio", "legendFormat": "ratio", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "noValue": "no traffic in window", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {"type": "row", "title": "Latency anatomy", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}},
    {
      "type": "timeseries", "title": "Latency percentiles", "description": "End-to-end retrieval latency. Percentiles are only meaningful after requests have completed.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "memory:context_latency_p50 >= 0", "legendFormat": "p50"},
        {"refId": "B", "expr": "memory:context_latency_p95 >= 0", "legendFormat": "p95"},
        {"refId": "C", "expr": "memory:context_latency_p99 >= 0", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "no traffic in window", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.35}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries", "title": "p95 by stage", "description": "Independent timings for profile, embed, search, rerank, and assemble. Lines are deliberately not stacked.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(memory_context_stage_duration_seconds_bucket[5m]))) >= 0", "legendFormat": "{{stage}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "no traffic in window", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "stacking": {"mode": "none"}, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {"type": "row", "title": "Evidence and ranking", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15}},
    {
      "type": "timeseries", "title": "Median candidates by retrieval arm", "description": "An arm at zero contributes no evidence. Use this before changing ranking weights.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (le, arm) (rate(memory_retrieval_arm_hits_bucket[10m]))) >= 0", "legendFormat": "{{arm}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "no traffic in window", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "auto"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "piechart", "title": "Trust tier of returned items", "description": "Trust composition of items delivered to callers in the selected period.",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (tier) (increase(memory_pack_items_total[6h]))", "legendFormat": "{{tier}}", "instant": true, "range": false}],
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "no traffic in window", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "type": "barchart", "title": "Pack exclusions by reason", "description": "Explains thin packs: budget limits, duplicates, trust floors, or other assembly decisions.",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (reason) (increase(memory_pack_dropped_total[6h]))", "legendFormat": "{{reason}}", "format": "time_series", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"orientation": "horizontal", "legend": {"displayMode": "hidden", "placement": "bottom", "showLegend": false}, "xTickLabelRotation": 0}
    },
    {"type": "row", "title": "Request outcomes", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}},
    {
      "type": "timeseries", "title": "Vector-degraded packs", "description": "Rate of fallbacks from vector retrieval over time.",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 25}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "rate(memory_pack_degraded_total[5m])", "legendFormat": "degraded packs / second"}],
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "0", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "type": "timeseries", "title": "API response outcomes", "description": "All API requests by response status. Use Explore to correlate errors with trace and log evidence.",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 25}, "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "0", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "stacking": {"mode": "normal"}, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
